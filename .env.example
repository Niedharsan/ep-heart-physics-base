# Server-side only. Never expose this as a VITE_ variable.
OPENAI_API_KEY=

# Optional model override. The tutor endpoint defaults to gpt-5-mini.
OPENAI_MODEL=gpt-5-mini

# Optional when the browser and tutor API are deployed on different origins.
# Example: https://niedharsan.github.io
EP_TUTOR_ALLOWED_ORIGIN=

# Optional browser override for a separately deployed tutor backend.
# Same-origin deployments use /api/tutor automatically.
VITE_EP_TUTOR_ENDPOINT=
